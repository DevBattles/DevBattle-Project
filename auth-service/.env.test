# Test environment configuration
NODE_ENV=test
PORT=4001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/devbattle_auth_test
JWT_ACCESS_SECRET=test-access-secret-key-minimum-32-chars
JWT_REFRESH_SECRET=test-refresh-secret-key-minimum-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000
COOKIE_SECRET=test-cookie-secret
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
SMTP_HOST=smtp.test.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=test@test.com
SMTP_PASS=test-password
SMTP_FROM_NAME=DevBattle Test
SMTP_FROM_EMAIL=test@devbattle.com
CLIENT_URL=http://localhost:3000
LOG_LEVEL=error
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
